<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SecondLook collects nothing and tracks nothing. The message text and
	     any screenshot you check are processed entirely on-device (Vision +
	     a local rule engine) and are never uploaded. Saved checks store only
	     which rules matched, the hiring stage, and a date - never the message
	     text itself. The app makes no network calls. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app reads/writes only its own preferences and saved-check history. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

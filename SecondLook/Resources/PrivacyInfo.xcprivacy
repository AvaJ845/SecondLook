<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SecondLook collects nothing and tracks nothing. The message text and
	     any screenshot you check are processed entirely on-device (Vision +
	     a local rule engine) and are never uploaded. Saved checks store only
	     which rules matched, the hiring stage, and a date - never the message
	     text itself.

	     The always-on report is on-device. When an AI backend is configured, the
	     plain-language summary is phrased server-side from the app's own rule
	     metadata only (which signals fired, the hiring stage) - never message
	     content.

	     One opt-in feature transmits user content: "Deep AI check" sends the
	     screenshot and message text to the backend for a vision model, only on
	     an explicit tap after a one-time consent. That content is declared below
	     as Other User Content, used only for app functionality, not linked to
	     identity, not used for tracking. It is not sent in the default flow. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app reads/writes only its own preferences and saved-check history. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
